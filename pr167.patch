From: Amisha Pandey <amisha.pandey2006@gmail.com>
Date: Fri, 24 Jul 2026 23:22:37 +0530
Subject: [PATCH 1/2] test: add Playwright E2E test suite and CI workflow for
 critical journeys (#79)

Description
This PR resolves Issue #79 by introducing end-to-end testing with Playwright to validate critical user flows (such as dashboard loading and project creation) and protect the application from regressions.

Changes Included:
E2E Test Suite: Added tests/critical-journeys.spec.ts to automate the validation of key application workflows (dashboard rendering, opening modals, filling project details, and confirming successful saves).

CI Automation: Created a GitHub Actions workflow configuration under .github/workflows/playwright.yml to run the Playwright test suite automatically on pushes and pull requests.
---
 tests/critical-journeys.spec.ts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100644 tests/critical-journeys.spec.ts

diff --git a/tests/critical-journeys.spec.ts b/tests/critical-journeys.spec.ts
new file mode 100644
index 0000000..affd890
--- /dev/null
+++ b/tests/critical-journeys.spec.ts
@@ -0,0 +1,17 @@
+import { test, expect } from '@playwright/test';
+
+test.describe('ProjectPilot Critical User Journeys', () => {
+  test('should successfully load dashboard and create a new project', async ({ page }) => {
+    await page.goto('/dashboard');
+    await expect(page.locator('text=ProjectPilot')).toBeVisible();
+
+    const addProjectButton = page.locator('button:has-text("Add Project"), button:has-text("New Project")').first();
+    await addProjectButton.click();
+
+    await page.fill('input[name="title"]', 'E2E Test Automated Project');
+    await page.fill('textarea[name="description"]', 'Automated test description verifying golden path.');
+
+    await page.click('button:has-text("Save"), button:has-text("Create Project")');
+    await expect(page.locator('text=E2E Test Automated Project')).toBeVisible();
+  });
+});

