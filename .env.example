# AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Database connection string (PostgreSQL)
# You can use a local database or a cloud provider like Neon/Supabase
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Clerk Authentication Keys
# Get these from your Clerk dashboard (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
CLERK_SECRET_KEY="your_clerk_secret_key"

# Stripe Keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
# Find your price ID in Stripe Dashboard > Products
STRIPE_PRICE_ID="price_your_monthly_plan_price_id"
# Stripe webhook secret (from Stripe CLI or Dashboard webhook settings)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Secret used to authenticate the daily cron job that permanently deletes
# accounts soft-deleted more than 30 days ago. Vercel Cron automatically
# sends this as an "Authorization: Bearer <value>" header when it's set.
CRON_SECRET="your_random_cron_secret"