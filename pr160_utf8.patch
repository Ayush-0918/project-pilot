+
+      <div className="flex items-center gap-1.5 px-4 py-3 rounded-2xl rounded-tl-sm bg-slate-800/80 dark:bg-slate-900/90 border border-indigo-500/20 shadow-sm shadow-indigo-500/5 backdrop-blur-sm">
