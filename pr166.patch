+  // Timeout monitoring (15-second threshold)
+  useEffect(() => {
+    let timer: NodeJS.Timeout;
+    if (isLoading) {
+      setIsTimedOut(false);
+      timer = setTimeout(() => {
+        setIsTimedOut(true);
