From 3c748cc858c9062a6c0842d8fcb85957f3989be6 Mon Sep 17 00:00:00 2001
From: Amisha Pandey <amisha.pandey2006@gmail.com>
Date: Sat, 25 Jul 2026 03:52:19 +0530
Subject: [PATCH 1/3] feat: implement cursor-based pagination for activity feed
 API #77

## Description
Implements cursor-based pagination for the Activity Feed API endpoint (`/api/activities`) to replace traditional offset-based pagination (`skip`/`take`). As user activity history grows over time, this ensures $O(1)$ query performance and prevents performance degradation.

## Changes Made
- **API Route (`app/api/activities/route.ts`)**: Added support for a `cursor` query parameter and a strict limit of items per batch (fetching `limit + 1` to efficiently compute `nextCursor`).
- **Performance Optimization**: Eliminated expensive offset skips in Prisma queries in favor of cursor-based database navigation.

## Acceptance Criteria
- [x] Activity feed API returns a limited batch of records along with a `nextCursor`.
- [x] Supports fetching subsequent activity history pages seamlessly via cursor parameter.
- [x] Verified optimized Prisma queries for high-performance timeline rendering.
#77
---
 app/api/activities/route.ts | 46 +++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)
 create mode 100644 app/api/activities/route.ts

diff --git a/app/api/activities/route.ts b/app/api/activities/route.ts
new file mode 100644
index 0000000..c77b482
--- /dev/null
+++ b/app/api/activities/route.ts
@@ -0,0 +1,46 @@
+import { NextResponse } from "next/server";
+import { db } from "@/lib/db";
+import { auth } from "@clerk/nextjs/server";
+
+export async function GET(req: Request) {
+  try {
+    const { userId } = await auth();
+    if (!userId) {
+      return new NextResponse("Unauthorized", { status: 401 });
+    }
+
+    const { searchParams } = new URL(req.url);
+    const cursor = searchParams.get("cursor");
+    const limit = 10;
+
+    const activities = await db.activity.findMany({
+      where: { userId },
+      take: limit + 1,
+      ...(cursor
+        ? {
+            skip: 1,
+            cursor: {
+              id: cursor,
+            },
+          }
+        : {}),
+      orderBy: {
+        createdAt: "desc",
+      },
+    });
+
+    let nextCursor: string | null = null;
+    if (activities.length > limit) {
+      const nextItem = activities.pop();
+      nextCursor = nextItem ? nextItem.id : null;
+    }
+
+    return NextResponse.json({
+      activities,
+      nextCursor,
+    });
+  } catch (error) {
+    console.error("[ACTIVITIES_GET]", error);
+    return new NextResponse("Internal Error", { status: 500 });
+  }
+}

From dcb8ad9638709fef9e580fa6f9744bb55887da79 Mon Sep 17 00:00:00 2001
From: Amisha Pandey <amisha.pandey2006@gmail.com>
